# ========================
# APPLICATION
# ========================
APP_NAME=WereTicket
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ========================
# DATABASE (MySQL via Docker)
# ========================
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=wereticket
DB_USERNAME=wereticket_user
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootpassword

# ========================
# REDIS (Cache & Sessions)
# ========================
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_DRIVER=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis

# ========================
# MAIL (Mailhog pour développement)
# ========================
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@wereticket.com
MAIL_FROM_NAME="${APP_NAME}"

# ========================
# DOCKER CONFIGURATION
# ========================
# Ports exposés
APP_PORT=8000
DB_PORT=3306
REDIS_PORT=6379
PMA_PORT=8080
MAILHOG_PORT=8025
MAILHOG_SMTP_PORT=1025

# Options d'initialisation
AUTO_MIGRATE=true
AUTO_SEED=false

# User/Group IDs (pour les permissions)
USER_ID=1000
GROUP_ID=1000

# ========================
# BROADCAST
# ========================
BROADCAST_DRIVER=log

# ========================
# FILESYSTEM
# ========================
FILESYSTEM_DRIVER=local

# ========================
# AWS (si utilisé)
# ========================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ========================
# PUSHER (si utilisé)
# ========================
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ========================
# PAYMENT GATEWAYS
# ========================
# Stripe
STRIPE_KEY=
STRIPE_SECRET=

# PayPal
PAYPAL_MODE=sandbox
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
PAYPAL_LIVE_CLIENT_ID=
PAYPAL_LIVE_CLIENT_SECRET=

# Razorpay
RAZORPAY_KEY=
RAZORPAY_SECRET=

# Mollie
MOLLIE_KEY=

# Paytm
PAYTM_ENVIRONMENT=local
PAYTM_MERCHANT_ID=
PAYTM_MERCHANT_KEY=
PAYTM_MERCHANT_WEBSITE=
PAYTM_CHANNEL=
PAYTM_INDUSTRY_TYPE=

# Midtrans
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_IS_SANITIZED=true
MIDTRANS_IS_3DS=true

# Iyzico
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# CinetPay
CINETPAY_API_KEY=
CINETPAY_SITE_ID=

# ========================
# SOCIAL AUTHENTICATION
# ========================
# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Facebook
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=

# ========================
# RECAPTCHA
# ========================
NOCAPTCHA_SITEKEY=
NOCAPTCHA_SECRET=

# ========================
# OTHER SERVICES
# ========================
# MyFatoorah
MYFATOORAH_API_KEY=
MYFATOORAH_TEST_MODE=true
